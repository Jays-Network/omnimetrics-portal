-- 004_portal_reader_roles.down.sql.example
-- Rollback of 004_portal_reader_roles.sql.example.
-- RUN AS: postgres.   sudo -u postgres psql -v ON_ERROR_STOP=1 -d jaysnet_data -f <this file, copied without .example>
--
-- Only REVOKEs the two SELECT grants this migration made to the two reader roles
-- (needed before DROP ROLE succeeds), then drops the roles. Does not touch any other
-- privilege on the tracking tables (grafana_reader and others are unaffected).
-- Stop the app (or point DATABASE_URL_READONLY_* back at grafana_reader) first: open
-- connections of these roles block DROP ROLE.
--
-- CHECK AFTER: SELECT rolname FROM pg_roles WHERE rolname LIKE 'portal_reader%';  -- expect 0 rows

BEGIN;

REVOKE SELECT ON worldrisk_tracking FROM portal_reader_wr;
REVOKE SELECT ON adars_tracking     FROM portal_reader_adars;

REVOKE USAGE ON SCHEMA public FROM portal_reader_wr, portal_reader_adars;
REVOKE CONNECT ON DATABASE jaysnet_data FROM portal_reader_wr, portal_reader_adars;

DROP ROLE portal_reader_wr;      -- role-level settings are removed with the role
DROP ROLE portal_reader_adars;

COMMIT;
