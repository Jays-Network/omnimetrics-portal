-- 011_seed_managed_sources.down.sql.example
-- Rollback of 011. RUN AS: postgres (RLS bypass is needed to delete env: rows).
--   sudo -u postgres psql -v ON_ERROR_STOP=1 -d jaysnet_data -f <this file, copied without .example>
-- Roll this back FIRST (before 010 and below).
--
-- Deletes exactly the two managed integrations (matched on org slug, name AND env: source, so a
-- user-made integration with another name is never touched) and the global host localhost:5432.
-- DATA LOSS: datasets and dataset fields built on those integrations are deleted with them
-- (ON DELETE CASCADE). Of the hosts only the GLOBAL localhost 5432-5432 row goes; org-specific
-- host rows are untouched. If you meanwhile began relying on that global host for other
-- integrations, they stop passing the allowlist: re-add it by hand.
--
-- CHECK AFTER: SELECT count(*) FROM app_integrations WHERE credential_source LIKE 'env:%';   -- 0
--              SELECT count(*) FROM app_allowed_hosts WHERE org_id IS NULL AND host='localhost' AND port_min=5432 AND port_max=5432;  -- 0

BEGIN;

DO $$
BEGIN
    IF NOT (SELECT rolsuper OR rolbypassrls FROM pg_roles WHERE rolname = current_user) THEN
        RAISE EXCEPTION '011 down: run as postgres (superuser/BYPASSRLS); current_user = %', current_user;
    END IF;
END $$;

DELETE FROM app_integrations i
 USING app_orgs o
 WHERE o.id = i.org_id
   AND ((o.slug = 'worldrisk' AND i.name = 'WorldRisk tracking (managed)' AND i.credential_source = 'env:DATABASE_URL_READONLY_WR')
     OR (o.slug = 'adars'     AND i.name = 'ADARS tracking (managed)'     AND i.credential_source = 'env:DATABASE_URL_READONLY_ADARS'));

DELETE FROM app_allowed_hosts
 WHERE org_id IS NULL AND host = 'localhost' AND port_min = 5432 AND port_max = 5432;

COMMIT;
