-- 007_integrations_datasets.sql.example
-- Allowed hosts (SSRF allowlist), integrations (encrypted credential columns),
-- dataset catalogue and field allowlist. PLAN_BUILDER sections 5 and A.
--
-- RUN AS:  portal_owner, in omnimetrics_portal. After 006.
--   psql -v ON_ERROR_STOP=1 -U portal_owner -d omnimetrics_portal -h localhost -f db/migrations/007_integrations_datasets.sql
-- Rollback: 007_integrations_datasets.down.sql.example
--
-- NO CREDENTIAL IS STORED BY THIS FILE, and it seeds no integration and no host (the managed
-- integrations that point at the external database jaysnet_data, and the localhost allowlist
-- entry, are seeded by 011). The
-- cred_* columns exist empty; the CHECKs only describe their shape:
--   * credential_source = 'stored'      -> cred_ciphertext, cred_nonce, cred_key_id are
--                                          either all NULL (not entered yet) or all set;
--                                          nonce is exactly 12 bytes (AES-256-GCM).
--   * credential_source = 'env:DATABASE_URL_READONLY_<NAME>' -> all three are NULL (managed
--                                          local source, e.g. env:DATABASE_URL_READONLY_WR).
--                                          ONLY that prefix is accepted (CHECK): an env: source
--                                          can never name JWT_SECRET, INTEGRATION_KEYS or any
--                                          other variable. 010 additionally limits who may write
--                                          a non-'stored' source (restrictive policy).
-- AES-GCM itself, the AAD (org_id|integration_id|key_id) and INTEGRATION_KEYS live in the
-- app (lib/integrations/secrets.ts); the database cannot verify them.
--
-- SECRET COLUMNS ARE NOT READABLE BY THE APP ROLES (010): column-level SELECT excludes
-- cred_ciphertext and cred_nonce, so `SELECT *` on this table fails for them by design. The
-- connector path reads them only through the function app_integration_credentials(id) (010).
-- has_credentials (generated) tells list queries whether a credential is stored without
-- reading it. There is no secret-free view any more: the grants do that job.
--
-- CHECKS AFTER RUNNING:
--   \dt app_*   -- + app_allowed_hosts, app_integrations, app_datasets, app_dataset_fields
--   \d app_integrations
--   SELECT count(*) FROM app_integrations WHERE cred_ciphertext IS NOT NULL;   -- 0
--   SELECT column_name, is_generated FROM information_schema.columns
--     WHERE table_name='app_integrations' AND column_name='has_credentials';     -- 1 row, ALWAYS
--   BEGIN; INSERT INTO app_integrations (org_id,kind,name,host,port,database,credential_source)
--     SELECT id,'postgres','x','h',1,'d','env:JWT_SECRET' FROM app_orgs LIMIT 1; ROLLBACK;  -- ERROR (check)

BEGIN;

-- Hosts the connector may reach. org_id NULL = global; platform-admin managed (010 policies).
CREATE TABLE app_allowed_hosts (
    id         UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    org_id     UUID REFERENCES app_orgs(id),
    host       TEXT NOT NULL,
    port_min   INTEGER NOT NULL,
    port_max   INTEGER NOT NULL,
    note       TEXT,
    added_by   UUID REFERENCES app_users(id),
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    CONSTRAINT app_allowed_hosts_host_check  CHECK (host = lower(host) AND host ~ '^[a-z0-9]([a-z0-9.:-]{0,251}[a-z0-9])?$'),
    CONSTRAINT app_allowed_hosts_ports_check CHECK (port_min BETWEEN 1 AND 65535 AND port_max BETWEEN 1 AND 65535 AND port_min <= port_max),
    CONSTRAINT app_allowed_hosts_note_len    CHECK (note IS NULL OR length(note) <= 300),
    CONSTRAINT app_allowed_hosts_unique UNIQUE NULLS NOT DISTINCT (org_id, host, port_min, port_max)
);

CREATE TABLE app_integrations (
    id                UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    org_id            UUID NOT NULL REFERENCES app_orgs(id),
    kind              TEXT NOT NULL,
    name              TEXT NOT NULL,
    host              TEXT NOT NULL,
    port              INTEGER NOT NULL,
    database          TEXT NOT NULL,
    ssl_mode          TEXT NOT NULL DEFAULT 'verify-full',
    relation_allowlist TEXT[] NOT NULL DEFAULT '{}',
    credential_source TEXT NOT NULL DEFAULT 'stored',
    cred_ciphertext   BYTEA,
    cred_nonce        BYTEA,
    cred_key_id       TEXT,
    has_credentials   BOOLEAN GENERATED ALWAYS AS (cred_ciphertext IS NOT NULL) STORED,
    status            TEXT NOT NULL DEFAULT 'active',
    rotated_at        TIMESTAMPTZ,
    created_by        UUID REFERENCES app_users(id),
    created_at        TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at        TIMESTAMPTZ NOT NULL DEFAULT now(),
    CONSTRAINT app_integrations_kind_check   CHECK (kind IN ('postgres', 'mysql')),     -- sqlite deferred past M5
    CONSTRAINT app_integrations_name_check   CHECK (name = btrim(name) AND length(name) BETWEEN 1 AND 100),
    CONSTRAINT app_integrations_port_check   CHECK (port BETWEEN 1 AND 65535),
    CONSTRAINT app_integrations_ssl_check    CHECK (ssl_mode IN ('disable', 'require', 'verify-ca', 'verify-full')),
    CONSTRAINT app_integrations_status_check CHECK (status IN ('active', 'disabled')),
    CONSTRAINT app_integrations_cred_source_check
        CHECK (credential_source = 'stored' OR credential_source ~ '^env:DATABASE_URL_READONLY_[A-Z0-9_]{1,32}$'),
    CONSTRAINT app_integrations_cred_shape_check CHECK (
        (credential_source = 'stored'
            AND ((cred_ciphertext IS NULL AND cred_nonce IS NULL AND cred_key_id IS NULL)
              OR (cred_ciphertext IS NOT NULL AND cred_nonce IS NOT NULL AND cred_key_id IS NOT NULL)))
        OR (credential_source <> 'stored'
            AND cred_ciphertext IS NULL AND cred_nonce IS NULL AND cred_key_id IS NULL)
    ),
    CONSTRAINT app_integrations_nonce_len CHECK (cred_nonce IS NULL OR octet_length(cred_nonce) = 12),
    CONSTRAINT app_integrations_org_id_key UNIQUE (org_id, id)
);
CREATE UNIQUE INDEX app_integrations_org_name_uq ON app_integrations (org_id, lower(name));

-- Dataset catalogue. relation = a table/view in the integration; named_query = the KEY
-- of a query defined in application code (never SQL text; no SQL is stored anywhere).
CREATE TABLE app_datasets (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    org_id          UUID NOT NULL REFERENCES app_orgs(id),
    integration_id  UUID NOT NULL,
    key             TEXT NOT NULL,
    label           TEXT NOT NULL,
    relation        TEXT,
    named_query     TEXT,
    base_filter_ref TEXT,
    hidden_roles    TEXT[] NOT NULL DEFAULT '{}',
    created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    CONSTRAINT app_datasets_key_check    CHECK (key ~ '^[a-z][a-z0-9_]{0,62}$'),
    CONSTRAINT app_datasets_label_check  CHECK (length(btrim(label)) BETWEEN 1 AND 120),
    CONSTRAINT app_datasets_source_check CHECK ((relation IS NOT NULL) <> (named_query IS NOT NULL)),
    CONSTRAINT app_datasets_named_query_check CHECK (named_query IS NULL OR named_query ~ '^[a-z][a-z0-9_.]{0,62}$'),
    CONSTRAINT app_datasets_hidden_roles_check CHECK (hidden_roles <@ ARRAY['admin', 'builder', 'viewer']::text[]),
    CONSTRAINT app_datasets_org_key_key UNIQUE (org_id, key),
    CONSTRAINT app_datasets_org_id_key  UNIQUE (org_id, id),
    CONSTRAINT app_datasets_integration_fk
        FOREIGN KEY (org_id, integration_id) REFERENCES app_integrations (org_id, id) ON DELETE CASCADE
);
CREATE INDEX idx_app_datasets_integration ON app_datasets (org_id, integration_id);

-- Column allowlist and plain-language labels. A column not listed here cannot be used.
-- "column" is a reserved word, so the column is called column_name.
CREATE TABLE app_dataset_fields (
    org_id       UUID NOT NULL REFERENCES app_orgs(id),
    dataset_id   UUID NOT NULL,
    column_name  TEXT NOT NULL,
    label        TEXT NOT NULL,
    type         TEXT NOT NULL,
    aggregatable BOOLEAN NOT NULL DEFAULT false,
    position     INTEGER NOT NULL DEFAULT 0,
    hidden_roles TEXT[] NOT NULL DEFAULT '{}',
    PRIMARY KEY (org_id, dataset_id, column_name),
    CONSTRAINT app_dataset_fields_column_check CHECK (column_name ~ '^[A-Za-z_][A-Za-z0-9_]{0,62}$'),
    CONSTRAINT app_dataset_fields_label_check  CHECK (length(btrim(label)) BETWEEN 1 AND 120),
    CONSTRAINT app_dataset_fields_type_check   CHECK (type IN ('text', 'number', 'boolean', 'date', 'timestamp', 'json')),
    CONSTRAINT app_dataset_fields_hidden_roles_check CHECK (hidden_roles <@ ARRAY['admin', 'builder', 'viewer']::text[]),
    CONSTRAINT app_dataset_fields_dataset_fk
        FOREIGN KEY (org_id, dataset_id) REFERENCES app_datasets (org_id, id) ON DELETE CASCADE
);

COMMIT;
