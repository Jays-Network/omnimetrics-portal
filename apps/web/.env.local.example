# Copy to apps/web/.env.local and fill in real values. .env.local is git-ignored.
# Placeholders only: never commit real credentials.

# Portal's own tables (app_users, app_user_projects, app_audit_log).
# Uses the least-privilege portal_app role created by db/migrations/003_portal_app_role.sql.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://portal_app:CHANGE_ME_PORTAL_APP_PASSWORD@localhost:5432/jaysnet_data

# Tracking-data reads (dashboards, from Phase 2). Read-only role; 10s statement_timeout is applied by lib/db.ts.
DATABASE_URL_READONLY=postgresql://grafana_reader:CHANGE_ME_GRAFANA_READER_PASSWORD@localhost:5432/jaysnet_data

# Generate with: openssl rand -hex 32   (must be at least 32 characters)
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_EXPIRE_HOURS=24

# White-label branding (read at build time)
NEXT_PUBLIC_BRAND_NAME=OmniMetrics
NEXT_PUBLIC_BRAND_COLOR=#3b82f6
NEXT_PUBLIC_BRAND_FONT_DISPLAY=Syne
NEXT_PUBLIC_BRAND_FONT_BODY=DM+Sans
