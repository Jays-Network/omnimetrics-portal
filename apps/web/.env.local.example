# Copy to apps/web/.env.local and fill in real values. .env.local is git-ignored.
# Placeholders only: never commit real credentials.

# Portal's own tables (app_users, app_user_projects, app_audit_log).
# Uses the least-privilege portal_app role created by db/migrations/003_portal_app_role.sql.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://portal_app:CHANGE_ME_PORTAL_APP_PASSWORD@localhost:5432/omnimetrics_portal

# Tracking-data reads (dashboards, from Phase 2). Read-only role; 10s statement_timeout is applied by lib/db.ts.
DATABASE_URL_READONLY=postgresql://portal_reader:CHANGE_ME_PORTAL_READER_PASSWORD@localhost:5432/jaysnet_data

# Generate with: openssl rand -hex 32   (must be at least 32 characters)
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_EXPIRE_HOURS=24

# White-label branding (read at build time)
NEXT_PUBLIC_BRAND_NAME=OmniMetrics
NEXT_PUBLIC_BRAND_COLOR=#3b82f6
NEXT_PUBLIC_BRAND_FONT_DISPLAY=Syne
NEXT_PUBLIC_BRAND_FONT_BODY=DM+Sans

# 1 = tokens carry a session version (apply migration 012 first). Default off.
SESSION_VERSION=0

# INTEGRATION_KEYS: keys that encrypt stored integration credentials. Needed when PORTAL_DATA=pg (optional with mock).
# Format: id:base64[,id:base64...]  id = [a-z0-9_-]{1,32}; each key is 32 bytes (openssl rand -base64 32).
# The FIRST entry encrypts, every entry decrypts. No value here.
#INTEGRATION_KEYS=

# Portal director path (portal_platform) in the portal's OWN database.
DATABASE_URL_PLATFORM=postgresql://portal_platform:CHANGE_ME_PORTAL_PLATFORM_PASSWORD@localhost:5432/omnimetrics_portal
# External source jaysnet_data, read-only, one credential per organisation (managed integrations, migration 011).
DATABASE_URL_READONLY_WR=postgresql://portal_reader_wr:CHANGE_ME_READER_WR_PASSWORD@localhost:5432/jaysnet_data
DATABASE_URL_READONLY_ADARS=postgresql://portal_reader_adars:CHANGE_ME_READER_ADARS_PASSWORD@localhost:5432/jaysnet_data
